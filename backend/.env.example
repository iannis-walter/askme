# ── LLM provider ────────────────────────────────────────────────────────────
# Provider-agnostic, OpenAI-compatible. Switch provider with env vars only.
#   LLM_PROVIDER:  groq | ollama | mistral | openrouter   (default: ollama)
#
# Local dev  → Ollama: free, no key, fully private. Run `ollama serve` + a model.
# Production → Groq: open-source models (Llama 3.3), free tier, zero infra.
#              This is what you want behind a Vercel/serverless front-end, which
#              cannot run a model itself.

# --- Local dev (default): Ollama ---
LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# (Ollama needs no key. Make sure `ollama pull llama3.1` was run.)

# --- Production: Mistral free tier (uncomment, comment the block above) ---
# Mistral's "Free mode" is $0, no card, ~1 req/s, ~1B tokens/month — plenty for a
# portfolio, and keeps the app Mistral end-to-end. Key: https://console.mistral.ai
# LLM_PROVIDER=mistral
# LLM_API_KEY=your_mistral_api_key_here
# LLM_MODEL=mistral-small-latest
# LLM_MIN_INTERVAL_S=1.1                  # space upstream calls to respect ~1 req/s

# Other hosted options work the same way (groq, openrouter): set LLM_PROVIDER +
# LLM_API_KEY. Advanced override (presets already cover URL + model per provider):
# LLM_API_URL=

# ── Knowledge base ──────────────────────────────────────────────────────────
# Where the content lives (relative to the backend/ folder by default).
CONTENT_DIR=../content

# ── CORS ────────────────────────────────────────────────────────────────────
# The front-end origin allowed to call this service.
FRONTEND_ORIGIN=http://localhost:3000
