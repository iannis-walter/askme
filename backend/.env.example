# ── LLM provider ────────────────────────────────────────────────────────────
# Provider-agnostic. Switch provider with env vars only.
#   LLM_PROVIDER:  anthropic | groq | ollama | mistral | openrouter   (default: ollama)
#
# Local dev  → Ollama: free, no key, fully private. Run `ollama serve` + a model.
# Production → Groq: open-source models (Llama 3.3), free tier, zero infra.
#              This is what you want behind a Vercel/serverless front-end, which
#              cannot run a model itself.

# --- Local dev (default): Ollama ---
LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# (Ollama needs no key. Make sure `ollama pull llama3.1` was run.)

# --- Production: Claude (uncomment, comment the block above) ---
# Two tiers: a router (Haiku) sends questions answered by reading the CV to the
# simple model and judgment questions ("why is he a good fit?") to the complex
# one. Agent mode and job-fit always use the complex model.
# Key: https://platform.claude.com — link the Console org to a Claude Max plan
# (claude.ai → Settings → Billing → API credits) to spend its monthly credits.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=your_claude_api_key_here
# LLM_MODEL_SIMPLE=claude-haiku-5-5
# LLM_MODEL=claude-sonnet-5-5
# LLM_EFFORT_SIMPLE=low
# LLM_EFFORT_COMPLEX=medium
# LLM_ROUTING=on                          # off = everything goes to LLM_MODEL
# RETRIEVER=keyword                       # Claude has no embeddings API

# --- Alternative: Mistral free tier ---
# Mistral's "Free mode" is $0, no card, ~1 req/s, ~1B tokens/month — plenty for a
# portfolio, and keeps the app Mistral end-to-end. Key: https://console.mistral.ai
# LLM_PROVIDER=mistral
# LLM_API_KEY=your_mistral_api_key_here
# LLM_MODEL=mistral-small-latest
# LLM_MIN_INTERVAL_S=1.1                  # space upstream calls to respect ~1 req/s

# Other hosted options work the same way (groq, openrouter): set LLM_PROVIDER +
# LLM_API_KEY. Advanced override (presets already cover URL + model per provider):
# LLM_API_URL=

# ── Retrieval ───────────────────────────────────────────────────────────────
# auto = embeddings when provider is mistral + key present, else keyword.
# RETRIEVER=auto                  # auto | embeddings | keyword
# LLM_EMBED_MODEL=mistral-embed
# After editing content/, regenerate the cache: python build_embeddings.py

# ── Agent (tool-use loop, /chat/agent) ──────────────────────────────────────
# The model drives its own tool calls. Native function calling on mistral/groq/
# openrouter; a ReAct fallback for providers without it (e.g. ollama).
# AGENT_MODE=auto                   # auto | native | react   (auto: by provider)
# AGENT_MAX_STEPS=4                 # loop bound; graceful partial answer if hit
# AGENT_TOOL_TIMEOUT_S=15           # per tool-call timeout
# AGENT_LLM_TIMEOUT_S=60            # per LLM-call timeout
# AGENT_DEBUG=0                     # 1 = attach the full trace to the final event and
#                                   #     serve GET /trace/{request_id}. Keep off on a
#                                   #     public deploy: it exposes provider, model,
#                                   #     token counts and tool results to any caller.

# ── Knowledge base ──────────────────────────────────────────────────────────
# Where the content lives (relative to the backend/ folder by default).
CONTENT_DIR=../content

# ── CORS ────────────────────────────────────────────────────────────────────
# The front-end origin allowed to call this service.
FRONTEND_ORIGIN=http://localhost:3000

# ── Abuse protection ────────────────────────────────────────────────────────
# Shared secret between the Next.js proxy and this service. Unset = open service
# (local dev). Set it in production, with the SAME value on the front-end: every
# route except /health then refuses callers that do not send it, and rate limits
# apply per visitor instead of to the proxy's single address.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# BACKEND_SHARED_SECRET=
# DAILY_REQUEST_BUDGET=1500         # service-wide cap per UTC day (chat=1, job-fit=2, agent=4)
# LLM_MAX_TOKENS=4096               # output cap per Claude call, thinking included
# MAX_BODY_BYTES=1000000            # larger request bodies get a 413
# EXPOSE_DOCS=0                     # 1 = serve /docs, /redoc and /openapi.json
