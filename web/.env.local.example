# URL of the FastAPI backend (server-side only, never exposed to the browser)
BACKEND_URL=http://localhost:8000

# Shared secret sent to the backend with every proxied call. Must equal the
# backend's BACKEND_SHARED_SECRET. Leave unset in local dev if the backend has none.
# BACKEND_SHARED_SECRET=

# Only when self-hosting behind a reverse proxy that sets X-Real-IP /
# X-Forwarded-For itself (Vercel is detected automatically): forward the visitor's
# address so the backend rate-limits per visitor.
# TRUST_PROXY_HEADERS=1
